{
  // Characterization fixture for safe declarative contributions.
  "name": "fixture-declarative",
  "displayName": "Fixture Declarative",
  "publisher": "forge-tests",
  "version": "1.2.3",
  "engines": { "vscode": "^1.80.0" },
  "description": "Text containing // and a trailing-looking token ,}",
  "categories": ["Themes", "Programming Languages",],
  "activationEvents": ["onLanguage:fixture",],
  "extensionKind": ["ui", "workspace",],
  "contributes": {
    "themes": [
      { "label": "Fixture Dark", "uiTheme": "vs-dark", "path": "./themes/dark.json", },
    ],
    "snippets": [
      { "language": "fixture", "path": "./snippets/fixture.json", },
      { "language": 42, "path": "./snippets/ignored.json" },
    ],
    "languages": [
      {
        "id": "fixture",
        "aliases": ["Fixture", 42],
        "extensions": [".fixture"],
        "filenames": ["Fixturefile"],
        "firstLine": "^#!.*fixture",
        "configuration": "./language-configuration.json",
      },
    ],
    "iconThemes": [
      { "id": "fixture-icons", "label": "Fixture Icons", "path": "./icons/theme.json", },
    ],
  },
}
